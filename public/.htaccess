# 30 Temmuz 2026: sunucunun varsayilan PHP ayari (upload_max_filesize=2M)
# uygulamanin kendi kabul ettigi 5MB'lik gorsel yuklemesinden kucuktu - gercek
# telefon fotograflari (genelde 3-8MB) PHP tarafindan Laravel'e hic ulasmadan
# sessizce reddediliyordu. Sunucu LiteSpeed (PHP_SAPI=litespeed) kullaniyor -
# .user.ini denendi ama LSAPI'nin kendi ini onbellegi (300s bekleyip
# dogrulanmasina ragmen) degeri yenilemedi; LiteSpeed'in kendisi .htaccess
# icindeki php_value/php_admin_value satirlarini Apache mod_php taklit ederek
# DOGRUDAN kendisi isler (FastCGI/PHP-FPM'in aksine, burada "bilinmeyen
# direktif" hatasiyla tum siteyi 500'e dusurme riski YOK) - bu yuzden burada
# guvenle kullanilabilir.
php_value upload_max_filesize 10M
php_value post_max_size 60M

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 13 Temmuz 2026: admin.bakimevleri.com subdomain'i cPanel'de olusturulmus
    # ama ortak admin paneli kodda subdomain degil /admin path-prefix olarak
    # calisiyor (bkz. routes/web.php). Bu host'a gelen istekler admin paneli
    # yerine varsayilan marka (bakimevibul) genel sitesini gosteriyordu.
    RewriteCond %{HTTP_HOST} ^(www\.)?admin\.bakimevleri\.com$ [NC]
    RewriteRule ^ https://bakimevleri.com/admin/giris [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# 12 Temmuz 2026: PageSpeed Insights "Verimli onbellek surelerini kullanin"
# bulgusu icin - statik dosyalar (gorseller, build/ altindaki hash'li CSS/JS,
# fontlar) tarayicida hic onbelleklenmiyordu, her ziyarette yeniden
# indiriliyordu. build/ icindeki dosyalar Vite tarafindan icerik hash'i ile
# adlandirilir (ayni dosya asla degismez, yeni surum yeni dosya adi alir),
# bu yuzden 1 yillik "immutable" onbellek guvenlidir.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        <If "%{REQUEST_URI} =~ m#^/build/#">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
    </FilesMatch>
</IfModule>

# 13 Temmuz 2026: build/ altindaki CSS/JS zaten sikistirilarak (br) sunuluyordu
# ama dinamik Laravel sayfalari (HTML) hic sikistirilmiyordu - ana sayfa ~100KB
# gibi tam boyutuyla gidiyordu. Bu, sadece metin tabanli response'lari sikistirir,
# gorseller (zaten sikistirilmis format) etkilenmez.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
